# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

POSTGRES_USER=collector
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airlog

MQTT_USERNAME=collector
MQTT_PASSWORD=changeme

# Read-only Postgres role for the restapi service (see
# timescaledb/init/002-restapi-role.sh) - distinct from the collector's
# read-write credentials above.
RESTAPI_DB_USER=restapi
RESTAPI_DB_PASSWORD=changeme

# Shared secret the Qt6 dashboard sends as the X-API-Key header.
RESTAPI_API_KEY=changeme
